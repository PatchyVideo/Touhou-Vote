@import url('https://fonts.loli.net/css?family=Quicksand');

/*
 * Theme variables, generated from windi.config.js (source: src/theme/colors.ts).
 * Use var(--color-*) in component styles.
 */
:root {
  --color-accent-100: theme('colors.accent-color.100');
  --color-accent-200: theme('colors.accent-color.200');
  --color-accent-300: theme('colors.accent-color.300');
  --color-accent-400: theme('colors.accent-color.400');
  --color-accent-500: theme('colors.accent-color.500');
  --color-accent-600: theme('colors.accent-color.600');
  --color-accent-700: theme('colors.accent-color.700');
  --color-accent-800: theme('colors.accent-color.800');
  --color-accent-900: theme('colors.accent-color.900');
  --color-surface: theme('colors.subaccent');
  --color-divider: theme('colors.subaccent-divider');
  --color-text: theme('colors.textaccent');
  --color-text-muted: theme('colors.textmuted');
  --color-on-accent: theme('colors.onaccent');
  --color-mask: theme('colors.overlay');
}

body {
  @apply bg-white text-textaccent;
}

a {
  @apply cursor-pointer text-accent-color-600 hover:text-accent-color-800 transition transition-colors;
}

button {
  @apply text-white bg-accent-color-600 rounded shadow opacity-90;
  @apply transition transition-all hover:opacity-100 hover:bg-accent-color-700;
}

.buttonDisabled {
  @apply bg-accent-color-200 text-accent-color-700 cursor-not-allowed opacity-80;
  @apply hover:opacity-80 hover:bg-accent-color-200 hover:text-accent-color-700;
}

strong {
  @apply text-accent-color-700;
}

input,
textarea {
  @apply bg-transparent;
}

/* Native checkbox/radio accent */
input[type='checkbox'],
input[type='radio'] {
  accent-color: theme('colors.accent-color.600');
}

/* Subtle inner surface */
.innerBox {
  @apply bg-accent-color-100 shadow-inner rounded-xl;
}

/* Cards: white surface with light border and soft shadow */
.baseBox,
.baseBoxRounded,
.baseBoxShadow,
.baseBoxRoundedShadow {
  @apply bg-white;
  box-shadow: 0 0 0 1px theme('colors.accent-color.300'), 0 18px 36px -24px theme('colors.accent-color.800');
}
.baseBoxRounded,
.baseBoxRoundedShadow {
  @apply rounded-xl;
}

::selection {
  background-color: theme('colors.accent-color.200');
  color: theme('colors.accent-color.900');
}

/* Scrollbar */
*::-webkit-scrollbar {
  width: 16px;
}
*::-webkit-scrollbar-thumb {
  height: 56px;
  background-clip: content-box;
  background-color: theme('colors.gray.300');
  border: 4px solid transparent;
  border-radius: 9999px;
}
*::-webkit-scrollbar-thumb:hover {
  background-color: theme('colors.gray.400');
}

.quicksand {
  font-family: 'Quicksand';
}

.input-border,
.linkbox-border {
  box-shadow: inset 0 0 0 2px theme('colors.accent-color.200');
  position: relative;
  vertical-align: middle;
  @apply rounded-xl;
  &::before,
  &::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    transform-origin: center;
    transition: transform 5ms;
    @apply rounded-xl border-accent-color-600;
  }
  &::before {
    transform: scale3d(0, 1, 1);
    @apply border-t-2 border-b-2;
  }
  &::after {
    transform: scale3d(1, 0, 1);
    @apply border-l-2 border-r-2;
  }
}
.input-border:focus-within,
.linkbox-border:hover {
  &::before,
  &::after {
    transform: scale3d(1, 1, 1);
  }
}
.input-border-md,
.linkbox-border-md {
  @apply rounded;

  &::before,
  &::after {
    @apply rounded;
  }
}

.float-arrow-box {
  .float-arrow {
    @apply transform transition-transform duration-200 ease-out;
  }
}
.float-arrow-box:hover {
  .float-arrow {
    @apply translate-x-1/4;
  }
}

.ani-link {
  position: relative;
  &::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 1px;
    z-index: -1;
    background-color: theme('colors.accent-color.600');
    transition: all 200ms cubic-bezier(0.2, 0, 0, 1);
    transform-origin: bottom center;
    @apply rounded-md;
  }
}
.ani-link:hover {
  &::after {
    top: 0;
    height: 100%;
    background-color: theme('colors.accent-color.200');
  }
}

/* Background: white with a red radial gradient (v1.0.0 style) */
.page {
  @apply fixed -z-1 bg-white;
  background-image: radial-gradient(circle at top left, var(--color-accent-200) min(100vh), var(--color-surface) 0);
}
@variants md {
  .page {
    background-image: radial-gradient(circle at 120% 40%, var(--color-accent-200) min(80vw), var(--color-surface) 0);
  }
}
/* unocss does not support h-lvh */
@supports (height: 100lvh) {
  .page {
    @apply w-full;
    height: 100lvh;
  }
}
@supports not (height: 100lvh) {
  .page {
    @apply w-full h-full;
  }
}

/* Bounce  */
.bounce-home {
  animation: bounce 1s ease-in-out 0s 1;
}
@keyframes bounce {
  0%,
  100% {
    transform: translateY(0);
    animation-timing-function: cubic-bezier(0, 0, 0.2, 1);
  }
  50% {
    transform: translateY(-5%);
    animation-timing-function: cubic-bezier(0.8, 0, 1, 1);
  }
}
