# ============================================================
# THVote Result App Dockerfile 模板
#
# Result 应用依赖 GraphQL，需要 codegen
# ============================================================

FROM node:20-alpine AS build

RUN corepack enable && corepack prepare pnpm@7.33.7 --activate

WORKDIR /app

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

COPY . .

RUN pnpm install --frozen-lockfile

ARG BACKEND_URL=http://localhost:8000
ENV GRAPHQL_SCHEMA_URL=${BACKEND_URL}/graphql

RUN pnpm --filter @touhou-vote/result run codegen

RUN pnpm --filter @touhou-vote/result run build -- --mode test

# ---- Production Stage ----
FROM nginx:alpine

RUN echo 'server { \
    listen 8084; \
    location / { \
        root /usr/share/nginx/html; \
        try_files $uri $uri/ /index.html; \
    } \
    location /res-be/ { \
        proxy_pass http://thvote-backend:8000/; \
        proxy_http_version 1.1; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; \
        proxy_set_header X-Forwarded-Proto $scheme; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 8084

COPY --from=build /app/packages/result/dist /usr/share/nginx/html

CMD ["nginx", "-g", "daemon off;"]
