# ============================================================
# THVote Result App Dockerfile 模板
#
# Result 应用依赖 GraphQL，需要 codegen
# ============================================================

FROM node:20-alpine AS build

RUN corepack enable && corepack prepare pnpm@7.33.7 --activate

WORKDIR /app

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

COPY . .

RUN pnpm install --frozen-lockfile

# codegen 在 CI workflow 中执行（等待后端就绪后）
# 此处保留占位，实际构建时 workflow 会先运行 codegen 再执行 build
ARG BACKEND_URL=http://localhost:8000

RUN pnpm --filter @touhou-vote/result run codegen

RUN pnpm --filter @touhou-vote/result run build -- --mode test

# ---- Production Stage ----
FROM nginx:alpine

RUN echo 'server { \
    listen 8084; \
    location / { \
        root /usr/share/nginx/html; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 8084

COPY --from=build /app/packages/result/dist /usr/share/nginx/html

CMD ["nginx", "-g", "daemon off;"]
